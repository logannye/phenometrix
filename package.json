{
  "name": "phenometrix",
  "version": "0.1.0",
  "private": true,
  "description": "A nonclinical local prototype for quality-aware ambient face and voice measurement.",
  "license": "MIT",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --filter @phenometrix/capture-web dev",
    "demo:smoke": "pnpm --filter @phenometrix/capture-web demo:smoke",
    "build": "pnpm -r --if-present run build",
    "check": "bash scripts/validate-structure.sh",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:browser": "pnpm --filter @phenometrix/capture-web test:browser && pnpm --filter @phenometrix/clinician-review test:browser",
    "test:postgres": "pnpm --filter @phenometrix/encounter-service test:postgres",
    "dev:encounter": "pnpm --filter @phenometrix/encounter-service dev",
    "dev:evidence": "pnpm --filter @phenometrix/clinician-review dev",
    "test:voice": "uv run --project services/voice-inference --extra dev --locked python -m pytest services/voice-inference/tests",
    "verify": "pnpm test && pnpm test:browser && pnpm test:voice",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "npm run check && npm run test:unit && npm run typecheck && npm run build"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.26"
    }
  }
}
